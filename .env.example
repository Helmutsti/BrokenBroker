# Copia questo file in .env e scegli password lunghe e diverse.
# Il file .env non va condiviso né messo sotto controllo di versione.

# Amministratore del database (crea tabelle e regole).
DB_ADMIN_PASSWORD=cambia-questa-password-admin

# Utente con cui l'API si collega al database (vede solo ciò che le regole permettono).
APP_DB_PASSWORD=cambia-questa-password-app

# Porte sul computer che ospita Docker.
API_PORTA=3000
APP_PORTA=8080
DB_PORTA=5433
